/* pages/location-picker/index.wxss */

.picker-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--page-bg-alt);
  overflow: hidden;
}

/* ==================== 地图区域 ==================== */
.map-section {
  position: relative;
  height: 48vh;
  background: #f1f5f9;
  overflow: hidden;
}

.picker-map {
  width: 100%;
  height: 100%;
}

/* 搜索框 */
.search-bar {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 10;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: rgba(255,255,255,0.95);
  border-radius: var(--control-radius);
  padding: 0 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(15,23,42,0.08);
  border: 1rpx solid rgba(226,232,240,0.8);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary-alt);
  background: transparent;
  border: none;
}

.search-clear {
  font-size: 28rpx;
  color: #94a3b8;
  padding: 8rpx;
  display: none;
  flex-shrink: 0;
}

.search-clear.show {
  display: block;
}

/* 中心大头针 */
.center-pin {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -100%);
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.pin-label {
  display: flex;
  align-items: center;
  background: #283044;
  color: #eef0ff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: var(--pill-radius);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
  margin-bottom: 12rpx;
  max-width: 420rpx;
}

.pin-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-green);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.pin-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pin-icon-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pin-icon {
  width: 72rpx;
  height: 72rpx;
  background: var(--brand-green);
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(16,185,129,0.45);
  border: 4rpx solid #fff;
}

.pin-icon text {
  transform: rotate(45deg);
  font-size: 32rpx;
}

.pin-shadow {
  width: 28rpx;
  height: 12rpx;
  background: rgba(15,23,42,0.25);
  border-radius: 50%;
  filter: blur(3rpx);
  margin-top: 8rpx;
}

/* 地图控制按钮 */
.map-controls {
  position: absolute;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
}

.control-btn + .control-btn {
  margin-top: 16rpx;
}

.control-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.95);
  border-radius: var(--control-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(15,23,42,0.12);
  border: 1rpx solid rgba(226,232,240,0.9);
}

.control-icon {
  font-size: 36rpx;
  color: var(--brand-green-dark);
}

.control-group {
  display: flex;
  flex-direction: column;
  background: rgba(255,255,255,0.95);
  border-radius: var(--control-radius);
  box-shadow: 0 8rpx 24rpx rgba(15,23,42,0.12);
  border: 1rpx solid rgba(226,232,240,0.9);
  overflow: hidden;
}

.control-btn-zoom {
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #475569;
}

.control-divider {
  height: 1rpx;
  background: #f1f5f9;
}

/* ==================== POI 列表区域 ==================== */
.poi-section {
  flex: 1;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(15,23,42,0.06);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-top: -28rpx;
  z-index: 20;
  position: relative;
}

.poi-handle {
  width: 72rpx;
  height: 8rpx;
  background: #cbd5e1;
  border-radius: 4rpx;
  margin: 20rpx auto 8rpx;
  flex-shrink: 0;
}

.poi-list {
  flex: 1;
  padding: 0 32rpx;
  padding-bottom: 200rpx;
}

.poi-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.poi-left {
  display: flex;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.poi-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--mint-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.poi-icon-selected {
  background: #d1fae5;
}

.poi-icon {
  font-size: 32rpx;
}

.poi-detail {
  flex: 1;
  min-width: 0;
}

.poi-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.poi-name-row > view + view,
.poi-name-row > text + text {
  margin-left: 12rpx;
}

.poi-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary-alt);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-name-bold {
  font-weight: 700;
  color: var(--text-primary-alt);
}

.poi-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--brand-green-dark);
  background: var(--mint-bg);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(167,243,208,0.7);
  flex-shrink: 0;
}

.poi-address {
  font-size: 24rpx;
  color: var(--text-hint-alt);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-check {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding-top: 16rpx;
}

.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--brand-green);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(16,185,129,0.3);
}

.check-icon {
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
}

/* 空状态 */
.poi-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
}

.empty-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #94a3b8;
  margin-bottom: 16rpx;
}

.empty-link {
  font-size: 22rpx;
  color: var(--brand-green);
  font-weight: 600;
  text-decoration: underline;
}

/* ==================== 底部确认按钮 ==================== */
.confirm-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #fff 60%, rgba(255,255,255,0.95) 100%);
  z-index: 30;
}

.confirm-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  background: var(--brand-green);
  border-radius: var(--control-radius);
  box-shadow: 0 12rpx 32rpx rgba(16,185,129,0.35);
}

.confirm-btn > text + text {
  margin-left: 16rpx;
}

.confirm-btn:active {
  background: var(--brand-green-hover);
  transform: scale(0.99);
}

.confirm-icon {
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
}

.confirm-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

/* ==================== 加载状态 ==================== */
.poi-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #64748B;
}
