/* pages/index/index.wxss */

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--page-bg);
  overflow: hidden;
}

/* ==================== Header（自定义导航栏） ==================== */
.header {
  background: rgba(255,255,255,0.95);
  border-bottom: 1rpx solid #f1f5f9;
  /* padding-top 由 JS 动态设置（状态栏高度） */
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* height 由 JS 动态设置（导航栏内容区高度） */
}

/* 占位块，宽度与微信胶囊区域相同，使标题水平居中 */
.header-placeholder {
  flex-shrink: 0;
}

/* headline-md 规范：加大加粗主标题 */
.header-title {
  font-size: 34rpx;
  font-weight: 400;
  color: #131b2e;
  letter-spacing: 2rpx;
  flex: 1;
  text-align: center;
}

/* ==================== 模式切换栏 ==================== */
.mode-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  background: rgba(255,255,255,0.8);
  border-bottom: 1rpx solid #f1f5f9;
  flex-shrink: 0;
}

.tab-switcher {
  position: relative;
  display: flex;
  align-items: center;
  padding: 8rpx;
  background: #f1f5f9;
  border-radius: var(--pill-radius);
  border: 1rpx solid var(--border-color);
  width: 420rpx;
}

.tab-pill {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: var(--pill-radius);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  transition: transform 0.3s ease;
}

.tab-pill-map {
  transform: translateX(0);
}

.tab-pill-list {
  transform: translateX(100%);
}

.tab-btn {
  position: relative;
  z-index: 1;
  width: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #64748b;
  transition: color 0.3s;
}

.tab-active {
  color: var(--wechat-green);
  font-weight: 700;
}

.tab-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

/* 个人资料入口：绝对定位固定在右侧 */
.profile-entry {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.profile-avatar-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.profile-avatar-default {
  width: 100%;
  height: 100%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder {
  font-size: 32rpx;
  color: #94a3b8;
}

.profile-avatar-img {
  width: 100%;
  height: 100%;
  background: var(--brand-green);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.profile-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #cbd5e1;
  border: 4rpx solid #fff;
}

.dot-online {
  background: var(--wechat-green);
}

/* ==================== 定位提示条 ==================== */
.location-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 32rpx;
  background: #fffbeb;
  flex-shrink: 0;
  min-height: 64rpx;
}

.banner-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.banner-icon {
  font-size: 28rpx;
  color: #d97706;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.banner-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #92400e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.banner-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.banner-link {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #b45309;
}

.banner-arrow {
  font-size: 24rpx;
  color: #d97706;
  margin-left: 4rpx;
}

.banner-divider {
  width: 1rpx;
  height: 20rpx;
  background: #fde68a;
  margin: 0 16rpx;
}

.banner-close {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(180,83,9,0.6);
  padding: 8rpx;
}

/* ==================== 地图模式 ==================== */
.map-view {
  flex: 1;
  position: relative;
  background: #eef2f6;
  overflow: hidden;
}

/* 地图左上角悬浮位置入口（毛玻璃胶囊） */
.map-location-capsule {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 9999rpx;
  padding: 12rpx 24rpx;
  max-width: 300rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.map-loc-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
  line-height: 1;
  flex-shrink: 0;
}

.map-loc-text {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-loc-arrow {
  font-size: 20rpx;
  color: #94a3b8;
  margin-left: 4rpx;
  flex-shrink: 0;
}

.map-component {
  width: 100%;
  height: 100%;
}

/* 地图底部球友名片 */
.map-bottom-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  z-index: 30;
  transition: all 0.3s ease;
}

.card-hide {
  transform: translateY(120%);
  opacity: 0;
  pointer-events: none;
}

.card-show {
  transform: translateY(0);
  opacity: 1;
}

.card-inner {
  background: rgba(255,255,255,0.95);
  border-radius: var(--card-radius);
  padding: 28rpx;
  box-shadow: 0 16rpx 60rpx rgba(0,0,0,0.08);
  border: 1rpx solid #f1f5f9;
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-user-info {
  display: flex;
  align-items: flex-start;
  flex: 1;
}

.card-avatar-wrap {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--control-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.avatar-online-dot {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--wechat-green);
  border: 4rpx solid #fff;
}

.card-user-detail {
  flex: 1;
  min-width: 0;
}

.card-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-right: 16rpx;
}

.card-style-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #047857;
  background: var(--mint-bg);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #a7f3d0;
}

.card-location-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-location-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.card-location-text {
  font-size: 24rpx;
  color: #94a3b8;
}

.card-tags-row {
  display: flex;
  flex-wrap: wrap;
}

.card-tags-row .card-tag + .card-tag {
  margin-left: 12rpx;
}

.card-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.level-tag {
  color: #047857;
  background: var(--mint-bg);
  border: 1rpx solid #a7f3d0;
}

.fee-tag {
  color: #475569;
  background: #f8fafc;
  border: 1rpx solid var(--border-color);
}

.card-close-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #94a3b8;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 等待响应横幅 */
.card-sent-banner,
.player-sent-banner {
  display: flex;
  align-items: flex-start;
  background: var(--mint-bg);
  border: 1rpx solid #a7f3d0;
  border-radius: var(--control-radius);
  padding: 20rpx;
  margin-top: 20rpx;
}

.sent-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  line-height: 1;
  margin-top: 4rpx;
}

.sent-content {
  flex: 1;
}

.sent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.sent-status {
  font-size: 20rpx;
  font-weight: 700;
  color: #d97706;
}

.sent-time {
  font-size: 20rpx;
  color: #94a3b8;
}

.sent-text {
  font-size: 22rpx;
  color: #475569;
  line-height: 1.5;
}

/* 对方已同意横幅 */
.card-accepted-banner,
.player-wx-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--mint-bg);
  border: 1rpx solid #a7f3d0;
  border-radius: var(--control-radius);
  padding: 20rpx;
  margin-top: 20rpx;
}

.accepted-left,
.wx-left {
  display: flex;
  align-items: center;
}

.accepted-icon-wrap,
.wx-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--wechat-green);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.accepted-icon,
.wx-icon {
  font-size: 32rpx;
}

.accepted-detail,
.wx-detail {
  display: flex;
  flex-direction: column;
}

.accepted-label,
.wx-label {
  font-size: 20rpx;
  font-weight: 600;
  color: #047857;
  line-height: 1;
  margin-bottom: 8rpx;
}

.accepted-wx,
.wx-id {
  font-size: 24rpx;
  font-weight: 700;
  font-family: monospace;
  color: var(--text-primary);
}

.accepted-copy-btn,
.wx-copy-btn {
  padding: 12rpx 24rpx;
  background: var(--wechat-green);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(7,193,96,0.3);
  flex-shrink: 0;
}

/* 婉拒横幅 */
.card-declined-banner,
.player-declined-banner {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 1rpx solid rgba(226,232,240,0.8);
  border-radius: var(--control-radius);
  padding: 20rpx;
  margin-top: 20rpx;
}

.declined-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.declined-text {
  font-size: 22rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 打招呼按钮 */
.card-action {
  margin-top: 20rpx;
}

.greet-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: var(--control-radius);
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.greet-btn-active {
  background: var(--wechat-green);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.3);
}

.greet-btn-disabled {
  background: #f1f5f9;
  color: #94a3b8;
}

/* ==================== 列表模式 ==================== */
.list-view {
  flex: 1;
  background: #f6f8fa;
  padding: 24rpx;
  box-sizing: border-box;
}

.list-tip {
  display: flex;
  align-items: center;
  background: var(--mint-bg);
  border: 1rpx solid rgba(167,243,208,0.8);
  border-radius: var(--control-radius);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 22rpx;
  color: #047857;
  line-height: 1.4;
}

/* 球友卡片 */
.player-card {
  background: #fff;
  border-radius: var(--control-radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 1rpx solid #f1f5f9;
}

.player-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.player-info {
  display: flex;
  align-items: flex-start;
  flex: 1;
}

.player-avatar-wrap {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.player-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--control-radius);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.player-online-dot {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #cbd5e1;
  border: 4rpx solid #fff;
}

.dot-active {
  background: var(--wechat-green);
}

.player-detail {
  flex: 1;
  min-width: 0;
}

.player-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.player-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-right: 16rpx;
}

.player-style-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.player-location {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 状态按钮 */
.player-status-btn {
  padding: 16rpx 28rpx;
  border-radius: var(--control-radius);
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--wechat-green);
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(7,193,96,0.2);
}

.waiting-btn {
  background: #f1f5f9;
  color: #94a3b8;
}

.accepted-btn {
  background: var(--mint-bg);
  color: #047857;
  font-weight: 700;
  border: 1rpx solid #a7f3d0;
}

.declined-btn {
  background: #f1f5f9;
  color: #94a3b8;
}

/* 标签行 */
.player-tags {
  display: flex;
  flex-wrap: wrap;
  padding-top: 20rpx;
}

.player-tags .player-tag + .player-tag {
  margin-left: 12rpx;
}

.player-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

/* 过期横幅 */
.player-expired-banner {
  display: flex;
  align-items: flex-start;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: var(--control-radius);
  padding: 20rpx;
  margin-top: 20rpx;
}

.expired-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  line-height: 1;
  margin-top: 4rpx;
}

.expired-text {
  font-size: 22rpx;
  color: #92400e;
  line-height: 1.5;
}

/* ==================== 弹窗 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15,23,42,0.6);
  z-index: 80;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.modal-show {
  opacity: 1;
  pointer-events: auto;
}

.modal-sheet {
  background: #fff;
  border-radius: var(--card-radius) var(--card-radius) 0 0;
  padding: 32rpx;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.sheet-up {
  transform: translateY(0);
}

.sheet-down {
  transform: translateY(100%);
}

.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  background: #cbd5e1;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
  margin-bottom: 24rpx;
}

.sheet-title-wrap {
  display: flex;
  flex-direction: column;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.sheet-subtitle {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.target-name {
  color: var(--wechat-green);
  font-weight: 600;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

/* 短语列表 */
.phrase-list {
  display: flex;
  flex-direction: column;
  max-height: 60vh;
}

.phrase-item + .phrase-item {
  margin-top: 20rpx;
}

.phrase-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  border-radius: var(--control-radius);
  border: 1rpx solid var(--border-color);
  background: #f8fafc;
  transition: all 0.2s;
}

.phrase-item:active {
  background: var(--mint-bg);
  border-color: var(--wechat-green);
  transform: scale(0.98);
}

.phrase-emoji {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  line-height: 1;
  margin-top: 4rpx;
}

.phrase-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #334155;
  line-height: 1.5;
  flex: 1;
}
